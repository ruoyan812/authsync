{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "authsync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",

  // 前端构建产物（Vite build.outDir 指向 ../worker/dist）
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 非敏感配置（公开变量）
  // PBKDF2_ITERATIONS: 免费版 CPU 上限为 10ms，默认 25000 迭代（约 5ms）以保证可用。
  // 若升级到 Workers Paid 计划（30s CPU），可提高到 600000 以获得更强的口令保护：
  //   npx wrangler secret put PBKDF2_ITERATIONS
  "vars": {
    "TURSO_DATABASE_URL": "libsql://authsync-ruoyan812.aws-ap-northeast-1.turso.io",
    "PBKDF2_ITERATIONS": "25000",
    "ADMIN_EMAIL": "royan.wang812@gmail.com"
  },

  "observability": {
    "enabled": true
  },

  // 自定义域名：需该域名的 DNS 托管在本 Cloudflare 账户
  // 修改 pattern 后重新执行 npx wrangler deploy 即可生效（会自动创建 DNS 记录与证书）
  "routes": [{ "pattern": "2fa.roooooyan.work", "custom_domain": true }]
}
